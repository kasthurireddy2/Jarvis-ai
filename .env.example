GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
JARVIS_NAME=JARVIS
USER_NAME=Sir
# Permanent memory (free Upstash Redis, REST API). Leave blank to use local memory.json.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
# LinkedIn posting (OAuth token with w_member_social scope + your person URN). Leave blank to disable.
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxxxx
